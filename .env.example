# Alpaca API credentials
ALPACA_API_KEY=your-alpaca-api-key-here
ALPACA_SECRET_KEY=your-alpaca-secret-key-here
ALPACA_PAPER=true

# LLM (OpenCode Go — OpenAI-compatible endpoint)
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_API_KEY=your-opencode-api-key-here
LLM_MODEL=deepseek-v4-flash

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173

# Redis (leave empty to use in-memory fallback)
REDIS_URL=

# Sentry (optional, leave empty to disable)
SENTRY_DSN=

# Database (leave empty for no DB, localStorage only)
DATABASE_URL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Pro subscription Price ID (from the Stripe Dashboard: Products -> your price)
STRIPE_PRICE_ID=price_pro_monthly
# Frontend URLs for Stripe Checkout redirect (override for production, e.g. https://vexarium.pages.dev/pricing?success=1)
STRIPE_SUCCESS_URL=http://localhost:5173/pricing?success=1
STRIPE_CANCEL_URL=http://localhost:5173/pricing?cancelled=1

# Environment: development | production
VEXARIUM_ENV=development
# Dev-only: treat everyone as Pro (NEVER true in production)
DEV_FORCE_PRO=false

# JWT auth
JWT_SECRET=change-me-in-production
JWT_EXPIRY_HOURS=24

# Trading thresholds
TAKE_PROFIT_THRESHOLD=0.10
CUT_LOSS_THRESHOLD=-0.08

# Rate limits (requests per window)
RATE_LIMIT_FREE=30
RATE_LIMIT_PRO=200